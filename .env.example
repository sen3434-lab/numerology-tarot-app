SUPABASE_URL=
SUPABASE_ANON_KEY=
PORT=3000

# Google Play coin purchases (see billing.js, data/coins_5_billing.sql)
# Long random string. Put its sha256 in public.billing_secret (coins_5_billing.sql).
BILLING_SECRET=
# Play Console service account JSON key (file path on the server; never commit it)
GOOGLE_SERVICE_ACCOUNT_FILE=/root/apps/secrets/play-service-account.json
# Only if the Play package name differs from the default
# GOOGLE_PLAY_PACKAGE=com.ozma.numerologytarot

# Only needed to run data/generate_content.js locally (not read by the
# deployed server). SUPABASE_SERVICE_ROLE_KEY bypasses RLS to write
# pre-generated card/compatibility copy — keep it out of any deployed env.
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
